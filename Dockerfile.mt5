FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    WINEPREFIX=/home/ramon/.wine \
    WINEARCH=win64 \
    WINEDEBUG=-all

ARG RAMON_UID=1000
ARG RAMON_GID=1000

# Both Wine architectures come from the same Noble repositories inside the image.
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       wine wine64 wine32 xvfb x11vnc novnc websockify ca-certificates fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "$RAMON_GID" ramon \
    && useradd --create-home --uid "$RAMON_UID" --gid "$RAMON_GID" ramon \
    && mkdir -p /home/ramon/.wine \
    && chown -R ramon:ramon /home/ramon

WORKDIR /opt/ramon
COPY mt5/Ramon.mq5 mt5/Ramon.mq5
COPY scripts/setup_local.sh scripts/setup_local.sh
COPY --chmod=755 scripts/mt5_container.sh /usr/local/bin/mt5-container
COPY --chmod=755 scripts/run_mt5.sh /usr/local/bin/run-mt5

USER ramon
EXPOSE 6080
ENTRYPOINT ["mt5-container"]
